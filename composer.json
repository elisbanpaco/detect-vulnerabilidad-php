{
    "name": "elisbanpaco/phpguard",
    "description": "Detector experimental de código malicioso PHP mediante análisis estático y GNN",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "bin": ["bin/phpguard"],
    "dist": {
        "type": "zip",
        "url": "https://github.com/elisbanpaco/detect-vulnerabilidad-php/releases/download/v0.2.0/phpguard-linux-x86_64.zip"
    },
    "archive": {
        "exclude": ["/dataset", "/artifacts", "/.venv", "/.agents", "/.codex", "/.aws", "/tests", "/src/test_*.py", "/src/__pycache__", "/src/*.pt", "/vendor", "/dist", "/build", "/runtime", "/packaging", "/.env", "/.env.*"]
    }
}
