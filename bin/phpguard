#!/usr/bin/env php
<?php
declare(strict_types=1);

$root = dirname(__DIR__);

try {
    if (!function_exists('proc_open')) {
        throw new RuntimeException('PHP debe permitir proc_open para iniciar el motor local.');
    }
    $python = getenv('PHPGUARD_PYTHON');
    $engine = $root . '/runtime/linux-x86_64/phpguard-engine';
    if (is_executable($engine)) {
        $command = [$engine];
    } elseif ($python !== false && $python !== '' && is_file($root . '/src/scan.py')) {
        $command = [$python, $root . '/src/scan.py'];
    } else {
        if (PHP_OS_FAMILY !== 'Linux' || php_uname('m') !== 'x86_64') {
            throw new RuntimeException('Esta distribución requiere Linux x86-64 con glibc; no incluye un motor para esta plataforma.');
        }
        throw new RuntimeException('Falta el motor empaquetado. Instala la distribución de la versión con Composer --prefer-dist.');
    }
    $process = proc_open(
        [...$command, ...array_slice($argv, 1)],
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes
    );
    if (!is_resource($process)) {
        throw new RuntimeException('No se pudo iniciar el motor local.');
    }
    $deadline = microtime(true) + 120;
    do {
        $status = proc_get_status($process);
        if (!$status['running']) {
            break;
        }
        if (microtime(true) >= $deadline) {
            proc_terminate($process);
            usleep(200000);
            if (proc_get_status($process)['running']) {
                proc_terminate($process, 9);
            }
            proc_close($process);
            throw new RuntimeException('El análisis superó el límite de 120 segundos.');
        }
        usleep(100000);
    } while (true);
    proc_close($process);
    exit(in_array($status['exitcode'], [0, 1, 2], true) ? $status['exitcode'] : 2);
} catch (Throwable $error) {
    fwrite(STDERR, json_encode(['verdict' => 'NO_ANALIZABLE', 'error' => $error->getMessage()], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL);
    exit(2);
}
